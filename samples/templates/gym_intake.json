      }
    },
    {
      "id": "writer_mg",
      "position": null,
      "data": {
        "type": "LocalFileWriterNode",
        "outputPath": "./output/muscle_gain_plan.txt",
        "append": false
      }
    },
    {
      "id": "embedder",
      "position": null,
      "data": {
        "type": "LocalEmbedderNode",
        "model": "nomic-embed-text"
      }
    },
    {
      "id": "chroma_store",
      "position": null,
      "data": {
        "type": "ChromaDbStoreNode",
        "collectionName": "gym_profiles",
        "chromaUrl": "http://localhost:8000",
        "inputMap": {
          "vector": "embedder.output",
          "document": "pdf_extractor.output"
        }
      }
    }
  ],
  "edges": [
