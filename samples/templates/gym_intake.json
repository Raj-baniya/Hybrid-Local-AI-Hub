{
  "version": 1,
  "nodes": [
    {
      "id": "watcher",
      "position": null,
      "data": {
        "type": "FileWatcherNode",
        "watchPath": "./gym_intake",
        "pattern": "*.pdf",
        "recursive": false
      }
    },
    {
      "id": "pdf_extractor",
      "position": null,
      "data": {
        "type": "PDFExtractorNode",
        "pageRange": null
      }
    },
    {
      "id": "llm_planner",
      "position": null,
      "data": {
        "type": "OllamaSelectorNode",
        "model": "llama3.2",
        "temperature": 0.5,
        "promptTemplate": "You are a personal fitness coach. Based on the following gym intake form, create a detailed personalised workout plan including goals, weekly schedule, and nutrition tips:\n\n{{pdf_extractor.output}}",
        "jsonMode": false
      }
    },
    {
      "id": "goal_router",
      "position": null,
      "data": {
        "type": "ConditionalRouterNode",
        "condition": "weight loss",
        "trueTarget": "writer_wl",
        "falseTarget": "writer_mg"
      }
    },
    {
      "id": "writer_wl",
      "position": null,
      "data": {
        "type": "LocalFileWriterNode",
        "outputPath": "./output/weight_loss_plan.txt",
