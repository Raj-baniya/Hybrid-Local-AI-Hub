{
  "name": "Instagram Automation Agent",
  "version": "1.0",
  "type": "workflow",
  "description": "Local Instagram automation agent for handling incoming messages and comments.",
  "enabled": true,
  "runtime": {
    "mode": "local",
    "host": "127.0.0.1",
    "port": 8000
  },
  "settings": {
    "poll_interval_seconds": 30,
    "max_actions_per_cycle": 10,
    "log_level": "INFO"
  },
  "credentials": {
    "instagram_access_token": "${INSTAGRAM_ACCESS_TOKEN}",
    "instagram_business_account_id": "${INSTAGRAM_BUSINESS_ACCOUNT_ID}",
    "meta_app_id": "${META_APP_ID}",
    "meta_app_secret": "${META_APP_SECRET}"
  },
  "triggers": [
    {
      "id": "instagram_message",
      "type": "instagram.message",
      "enabled": true
    },
    {
      "id": "instagram_comment",
      "type": "instagram.comment",
      "enabled": true
    }
  ],
  "nodes": [
    {
      "id": "receive_event",
      "type": "input",
      "name": "Receive Instagram Event",
      "action": "receive_event"
    },
    {
      "id": "extract_message",
      "type": "processor",
      "name": "Extract Message",
      "action": "extract_message"
    },
    {
      "id": "classify_message",
      "type": "processor",
      "name": "Classify Message",
      "action": "keyword_classification",
      "categories": {
        "greeting": [
          "hello",
          "hi",
          "hey",
          "hii"
        ],
        "pricing": [
          "price",
          "cost",
          "how much",
          "rate"
        ],
        "product": [
          "product",
          "available",
          "stock",
          "details"
        ],
        "order": [
          "order",
          "buy",
          "purchase",
          "delivery"
        ],
        "support": [
          "problem",
          "issue",
          "help",
          "not working"
        ],
        "human_request": [
          "human",
          "agent",
          "representative",
          "support agent"
        ]
      },
      "default_category": "general"
    },
    {
      "id": "generate_response",
      "type": "processor",
      "name": "Generate Response",
      "action": "rule_based_response",
      "responses": {
        "greeting": "Hi! Thanks for messaging us. How can we help you today?",
        "pricing": "Thanks for your interest. Please tell us which product or service you are interested in and we will share the current price.",
        "product": "Please send us the product name and we will provide the available details.",
        "order": "We can help with your order. Please send the product name and quantity.",
        "support": "Please describe the problem and we will help you resolve it.",
        "human_request": "Your request has been marked for human assistance.",
        "general": "Thanks for reaching out. Please tell us a little more about what you need."
      }
    },
    {
      "id": "human_check",
      "type": "condition",
      "name": "Human Escalation Check",
      "action": "check_category",
      "categories": [
        "human_request",
        "support"
      ]
    },
    {
      "id": "send_response",
      "type": "output",
      "name": "Send Instagram Response",
      "action": "send_response"
    },
    {
      "id": "store_conversation",
      "type": "storage",
      "name": "Store Conversation",
      "action": "sqlite",
      "database": "./instagram_agent.db"
    },
    {
      "id": "write_log",
      "type": "storage",
      "name": "Write Log",
      "action": "file",
      "file": "./logs/instagram_agent.log"
    }
  ],
  "connections": [
    {
      "from": "receive_event",
      "to": "extract_message"
    },
    {
      "from": "extract_message",
      "to": "classify_message"
    },
    {
      "from": "classify_message",
      "to": "human_check"
    },
    {
      "from": "human_check",
      "to": "generate_response"
    },
    {
      "from": "generate_response",
      "to": "send_response"
    },
    {
      "from": "send_response",
      "to": "store_conversation"
    },
    {
      "from": "store_conversation",
      "to": "write_log"
    }
  ],
  "safety": {
    "send_unsolicited_dms": false,
    "mass_follow": false,
    "mass_like": false,
    "mass_comment": false,
    "use_official_api": true,
    "respect_platform_limits": true
  },
  "storage": {
    "type": "sqlite",
    "database": "./instagram_agent.db"
  },
  "logging": {
    "enabled": true,
    "file": "./logs/instagram_agent.log"
  }
}
