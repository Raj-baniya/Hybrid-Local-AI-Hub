{
  "version": 1,
  "name": "System Resource Monitor",
  "nodes": [
    {
      "id": "node_schedule",
      "position": [100.0, 150.0],
      "data": {
        "type": "ScheduleNode",
        "cronExpression": "0 9 * * *"
      }
    },
    {
      "id": "node_cpu",
      "position": [300.0, 100.0],
      "data": {
        "type": "GetCpuUsageNode"
      }
    },
    {
      "id": "node_mem",
      "position": [300.0, 200.0],
      "data": {
        "type": "GetMemoryUsageNode"
      }
    },
    {
      "id": "node_ai",
      "position": [700.0, 150.0],
      "data": {
        "type": "OllamaSelectorNode",
        "model": "llama3.1",
        "promptTemplate": "Here is the current system resource usage:\nCPU: {{node_cpu.output}}%\nMemory: {{node_mem.output}}%\nBriefly summarize the resource health in a few bullet points.",
        "jsonMode": false
      }
    },
    {
      "id": "node_notify",
      "position": [1000.0, 150.0],
      "data": {
        "type": "NotifyDesktopNode",
        "title": "Daily System Report",
        "body": "{{node_ai.output}}"
      }
    }
  ],
  "edges": [
    {
      "id": "edge_1_cpu",
      "source": "node_schedule",
      "sourceHandle": null,
      "target": "node_cpu",
      "targetHandle": null
    },
    {
      "id": "edge_1_mem",
      "source": "node_schedule",
      "sourceHandle": null,
      "target": "node_mem",
      "targetHandle": null
    },
    {
      "id": "edge_2_cpu",
      "source": "node_cpu",
      "sourceHandle": null,
      "target": "node_ai",
      "targetHandle": null
    },
    {
      "id": "edge_2_mem",
      "source": "node_mem",
      "sourceHandle": null,
      "target": "node_ai",
      "targetHandle": null
    },
    {
      "id": "edge_3",
      "source": "node_ai",
      "sourceHandle": null,
      "target": "node_notify",
      "targetHandle": null
    }
  ]
}
